# develop.env for GitHub Actions (.github/workflows/ci.yml copies it to the
# repository root). Every value is a placeholder: the hosted run reaches no
# database but the ephemeral cluster tests/_pg.py starts on the loopback,
# and no key here is real. HPLDN_DIR_FP, HPLDN_CONFIG_FP and HPLDN_DATA_DIR
# are left out: src/hpldn/backend/tests/conftest.py derives them.
SQLALCHEMY_ENGINE=postgresql
POSTGRES_TESTING_USERNAME=ci
POSTGRES_TESTING_PASSWORD=ci
POSTGRES_TESTING_HOST=localhost
POSTGRES_TESTING_DATABASE=hpldn_test
POSTGRES_DEVELOP_USERNAME=ci
POSTGRES_DEVELOP_PASSWORD=ci
POSTGRES_DEVELOP_HOST=localhost
POSTGRES_DEVELOP_DATABASE=hpdbldn
DB_SCHEMA=staging
PGBOUNCER_AUTH_PASS=ci
POSTGRES_API_USERNAME=ci
POSTGRES_API_PASSWORD=ci
POSTGRES_API_HOST=localhost
POSTGRES_API_PORT=5432
POSTGRES_API_DATABASE=hpdbldn
POSTGRES_API_SSLMODE=disable
HPLDN_API_KEY=cionlynotasecret
HLDN_HOST=localhost
HPLDN_PASS_SECRET=ci-only-not-a-secret-ci-only-not-a-secret-ci-only
RECAPTCHA_SITE_KEY=ci-only-not-a-site-key
RECAPTCHA_SECRET_KEY=ci-only-not-a-secret-key
