# The repository root ignores every directory named "data" — that rule is meant
# for downloaded datasets, not for src/data, which holds the shared types, the
# areas provider and the borough geometry. Re-include it here so a fresh clone
# still builds.
!/src/data/

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
